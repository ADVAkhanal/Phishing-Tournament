<%- include('../partials/head') %>

<div class="card p-8 max-w-2xl mx-auto text-center">
  <% if (passed) { %>
    <div class="text-6xl mb-3">🎉</div>
    <h1 class="font-display text-3xl tracking-[1.2px] uppercase text-[var(--success-green)]">Passed</h1>
    <p class="text-[var(--text-secondary)] mt-2">You answered <%= correct %> out of <%= total %> correctly (<%= score %>%).</p>
    <div class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--brand-red)]/10 border border-[var(--brand-red)]/30 text-[var(--brand-red)] font-display tracking-[1.4px] uppercase">
      +<%= module.points_reward %><% if (score >= 90) { %> + 25 bonus<% } %> points
    </div>
    <div class="flex gap-3 justify-center mt-6">
      <a href="/training/<%= module.id %>/certificate" class="btn-primary">View Certificate</a>
      <a href="/training" class="btn-secondary">Back to Training</a>
    </div>
  <% } else { %>
    <div class="text-6xl mb-3">📚</div>
    <h1 class="font-display text-3xl tracking-[1.2px] uppercase text-[var(--warning-orange)]">Great Progress</h1>
    <p class="text-[var(--text-secondary)] mt-2">You scored <%= score %>% — you need <%= quiz.pass_score %>% to pass. Review the module and try again — no penalty.</p>
    <div class="flex gap-3 justify-center mt-6">
      <a href="/training/<%= module.id %>" class="btn-primary">Review & Retry</a>
      <a href="/training" class="btn-secondary">Back to Training</a>
    </div>
  <% } %>
</div>

<%- include('../partials/foot') %>
