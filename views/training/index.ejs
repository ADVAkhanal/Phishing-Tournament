<%- include('../partials/head') %>

<div class="mb-6">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)]">Training</div>
  <h1 class="font-display text-3xl tracking-[1.2px] uppercase">Training Center</h1>
  <p class="text-[var(--text-secondary)] mt-2 max-w-2xl">CMMC-aligned modules with handbook cross-references. Complete each module and pass the quiz to earn points and badges.</p>
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
  <% modules.forEach(m => { %>
    <a href="/training/<%= m.id %>" class="card p-5 flex flex-col gap-3 hover:border-[var(--brand-red)]/40 transition">
      <div class="flex items-start justify-between gap-2">
        <span class="badge"><%= m.category %></span>
        <span class="badge-yellow">+<%= m.points_reward %></span>
      </div>
      <h2 class="font-display text-lg tracking-[1px] uppercase text-[var(--text-primary)]"><%= m.title %></h2>
      <p class="text-[13px] text-[var(--text-secondary)] flex-1"><%= m.description %></p>
      <div class="flex items-center justify-between text-[11px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]">
        <span><%= m.estimated_minutes %> min · <%= m.difficulty %></span>
        <span class="text-[var(--brand-red)]"><%= m.cmmc_control %></span>
      </div>
      <% if (m.passed) { %>
        <div class="text-[11px] font-display tracking-[1.6px] uppercase text-[var(--accent-yellow)]">✓ Completed · <%= m.quiz_score %>%</div>
      <% } else if (m.completed_at) { %>
        <div class="text-[11px] font-display tracking-[1.6px] uppercase text-[var(--warning-orange)]">In progress</div>
      <% } else { %>
        <div class="text-[11px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]">Not started</div>
      <% } %>
    </a>
  <% }) %>
</div>

<%- include('../partials/foot') %>
