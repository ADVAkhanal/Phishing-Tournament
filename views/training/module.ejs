<%- include('../partials/head') %>

<a href="/training" class="font-display text-[11px] tracking-[1.6px] uppercase text-[var(--text-muted)] hover:text-[var(--brand-red)]">← Training Center</a>

<header class="mt-3 mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div>
    <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)]"><%= module.cmmc_control %> · <%= module.category %></div>
    <h1 class="font-display text-3xl tracking-[1.2px] uppercase"><%= module.title %></h1>
    <p class="text-[var(--text-secondary)] mt-2 max-w-3xl"><%= module.description %></p>
  </div>
  <div class="flex flex-col items-end gap-1">
    <div class="badge-yellow">+<%= module.points_reward %> PTS</div>
    <div class="text-[11px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]"><%= module.estimated_minutes %> min · <%= module.difficulty %></div>
  </div>
</header>

<article class="card p-8 prose-training">
  <%- module.content_html %>
</article>

<% if (quiz.questions && quiz.questions.length) { %>
<section class="card p-6 mt-6">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)] mb-3">Knowledge Check · Score <%= quiz.pass_score %>%+ to Pass</div>
  <form method="POST" action="/training/<%= module.id %>/quiz" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% quiz.questions.forEach((q, i) => { %>
      <div>
        <div class="font-medium text-[var(--text-primary)] mb-2"><span class="text-[var(--brand-red)]"><%= i + 1 %>.</span> <%= q.q %></div>
        <div class="space-y-1">
          <% q.options.forEach((opt, oi) => { %>
            <label class="flex items-start gap-3 p-2 rounded hover:bg-[var(--black-soft)] cursor-pointer">
              <input type="radio" name="answers[q<%= i %>]" value="<%= oi %>" required class="mt-1 accent-[var(--brand-red)]">
              <span class="text-[14px] text-[var(--text-secondary)]"><%= opt %></span>
            </label>
          <% }) %>
        </div>
      </div>
    <% }) %>
    <button type="submit" class="btn-primary">Submit Quiz</button>
  </form>
</section>
<% } %>

<% if (module.handbook_refs && module.handbook_refs.length) { %>
<section class="card p-6 mt-6 border-[var(--brand-red)]/30">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)] mb-2">📘 Related Company Policies</div>
  <p class="text-[13px] text-[var(--text-secondary)]">This training supports the following sections of the Advanced Companies Employee Handbook:</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <% module.handbook_refs.forEach(r => { %>
      <a href="<%= HANDBOOK_URL %>" target="_blank" rel="noopener" class="badge hover:text-[var(--brand-red)]">§<%= r %></a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (lastCompletion && lastCompletion.passed) { %>
<section class="mt-6 text-center">
  <a href="/training/<%= module.id %>/certificate" class="btn-secondary">📄 View Certificate</a>
</section>
<% } %>

<%- include('../partials/foot') %>
