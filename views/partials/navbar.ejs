<header class="sticky top-0 z-40 backdrop-blur-md bg-black/70 border-b border-[var(--border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-3 flex items-center gap-4">
    <a href="/dashboard" class="flex items-center gap-3 group">
      <img src="/public/images/logo.svg" alt="<%= companyShort %>" class="h-10 w-10 object-contain transition group-hover:scale-105" onerror="this.style.display='none'">
      <div class="leading-tight">
        <div class="font-display text-[17px] font-bold tracking-[2.6px] uppercase text-[var(--text-primary)]">
          ADVANCED<span class="text-[var(--brand-red)]"> · </span><span class="text-[var(--text-secondary)] font-semibold">PhishGuard</span>
        </div>
        <div class="text-[9.5px] font-display tracking-[2.4px] uppercase text-[var(--text-muted)]">Partners in Manufacturing &amp; Distribution</div>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-1 ml-6 flex-1">
      <% if (user) { %>
        <a class="nav-link <%= activeNav==='dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
        <a class="nav-link <%= activeNav==='leaderboard' ? 'active' : '' %>" href="/leaderboard">Leaderboard</a>
        <a class="nav-link <%= activeNav==='training' ? 'active' : '' %>" href="/training">Training</a>
        <a class="nav-link <%= activeNav==='report' ? 'active' : '' %>" href="/report">Report</a>
        <% if (user.role === 'admin') { %>
          <span class="mx-2 h-5 w-px bg-[var(--border-subtle)]"></span>
          <a class="nav-link <%= activeNav==='admin-campaigns' ? 'active' : '' %>" href="/admin/campaigns">Campaigns</a>
          <a class="nav-link <%= activeNav==='admin-templates' ? 'active' : '' %>" href="/admin/templates">Templates</a>
          <a class="nav-link <%= activeNav==='admin-analytics' ? 'active' : '' %>" href="/admin/analytics">Analytics</a>
          <a class="nav-link <%= activeNav==='admin-users' ? 'active' : '' %>" href="/admin/users">Users</a>
        <% } %>
      <% } %>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a class="nav-link" href="<%= HANDBOOK_URL %>" target="_blank" rel="noopener">📘 Handbook</a>
      <% if (user) { %>
        <div class="hidden sm:flex flex-col items-end leading-tight pr-2">
          <span class="font-display text-[11px] tracking-[1.6px] uppercase text-[var(--text-secondary)]"><%= user.first_name %> <%= user.last_name %></span>
          <span class="text-[10px] text-[var(--text-muted)]"><%= user.department %> · <%= user.role.toUpperCase() %></span>
        </div>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="nav-link" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a class="nav-link" href="/login">Sign in</a>
      <% } %>
    </div>
  </div>
</header>
