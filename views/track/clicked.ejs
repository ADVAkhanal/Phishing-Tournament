<%- include('../partials/head') %>

<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="card max-w-2xl w-full p-8">
    <div class="inline-block mb-4 text-[11px] font-display tracking-[2px] uppercase px-3 py-1 rounded bg-[var(--accent-yellow)]/10 border border-[var(--accent-yellow)]/30 text-[var(--accent-yellow)]">
      EXERCISE — EXERCISE — EXERCISE
    </div>

    <h1 class="font-display text-2xl tracking-[1.2px] uppercase text-[var(--text-primary)]">This was a training exercise</h1>
    <p class="text-[var(--text-secondary)] mt-2">
      No real email or data was ever at risk. That link came from a simulated phishing message — "<%= templateName %>" —
      sent as part of Advanced PMC's ongoing security awareness program. Clicking it is exactly how you'd expect to
      end up here in real life, which is the point: now you know what to look for next time.
    </p>

    <% if (redFlags && redFlags.length) { %>
      <div class="mt-6">
        <div class="font-display text-[11px] tracking-[1.8px] uppercase text-[var(--text-muted)] mb-2">What gave it away</div>
        <ul class="space-y-1.5">
          <% redFlags.forEach(f => { %>
            <li class="text-[13px] text-[var(--text-secondary)] pl-3 border-l-2 border-[var(--danger-red)]"><%= f %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (discussionQuestion) { %>
      <div class="mt-6 bg-[var(--black-soft)] rounded-lg p-4 border border-[var(--border-subtle)]">
        <div class="font-display text-[10px] tracking-[1.6px] uppercase text-[var(--text-muted)] mb-2">Worth thinking about — there's no wrong answer</div>
        <p class="text-[13px] text-[var(--text-primary)]"><%= discussionQuestion %></p>
      </div>
    <% } %>

    <% if (learningPoints) { %>
      <p class="text-[13px] text-[var(--text-secondary)] mt-6"><%= learningPoints %></p>
    <% } %>

    <% if (handbookRefs && handbookRefs.length) { %>
      <div class="mt-3 text-[11px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]">
        Handbook refs:
        <% handbookRefs.forEach(r => { %>
          <a href="<%= HANDBOOK_URL %>" target="_blank" rel="noopener" class="text-[var(--brand-red)] mr-2">§<%= r %></a>
        <% }) %>
      </div>
    <% } %>

    <div class="mt-8 pt-6 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row gap-3">
      <a href="/login" class="btn-primary flex-1 text-center">Sign in to your dashboard</a>
      <a href="<%= HANDBOOK_URL %>" target="_blank" rel="noopener" class="btn-secondary flex-1 text-center">📘 Employee Handbook</a>
    </div>
    <p class="text-[11px] text-[var(--text-muted)] mt-4 text-center">
      No action is required. Reporting is always the right move if this had been real — even if you're not sure.
    </p>
  </div>
</div>

<%- include('../partials/foot') %>
