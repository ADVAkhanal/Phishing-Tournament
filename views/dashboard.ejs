<%- include('partials/head') %>

<!-- Welcome banner -->
<section class="card p-6 mb-6 relative overflow-hidden">
  <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-[var(--brand-red)]/10 blur-3xl"></div>
  <div class="relative flex flex-col lg:flex-row lg:items-center gap-6">
    <div class="flex-1">
      <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)]">Welcome back</div>
      <h1 class="font-display text-3xl tracking-[1.2px] uppercase mt-1 text-[var(--text-primary)]"><%= user.first_name %> <%= user.last_name %></h1>
      <div class="mt-2 text-[var(--text-secondary)]">Rank: <span class="font-semibold text-[var(--text-primary)]"><%= stats.rank %></span> · <%= user.department %></div>
    </div>
    <a href="/report" class="btn-primary text-center text-base !py-3 !px-6 shadow-lg shadow-[var(--brand-red)]/20">
      🚨 Report Suspicious Email
    </a>
  </div>
</section>

<!-- Stats grid -->
<section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <%- include('partials/stats-card', { icon: '🎯', label: 'Total Points', value: stats.total, sub: stats.monthly + ' this month' }) %>
  <%- include('partials/stats-card', { icon: '🏅', label: 'Badges Earned', value: stats.badges, sub: 'See profile' }) %>
  <%- include('partials/stats-card', { icon: '🛡️', label: 'Company Resilience', value: resilience.score, sub: resilience.tier.label }) %>
  <%- include('partials/stats-card', { icon: '📊', label: 'Simulations', value: resilience.totalSimulations, sub: resilience.reportRate + '% reported' }) %>
</section>

<!-- Threat level gauge + leaderboard preview -->
<section class="grid lg:grid-cols-3 gap-6 mb-6">
  <div class="card p-6 lg:col-span-1">
    <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Company Threat Level</div>
    <div class="relative">
      <svg viewBox="0 0 200 110" class="w-full h-auto">
        <path d="M10 100 A 90 90 0 0 1 190 100" fill="none" stroke="#2A2A2D" stroke-width="14" stroke-linecap="round"/>
        <% const gaugeFrac = (resilience.score || 0) / 100; %>
        <% const gaugeColor = resilience.tier.color; %>
        <path d="M10 100 A 90 90 0 0 1 190 100" fill="none" stroke="<%= gaugeColor %>" stroke-width="14" stroke-linecap="round"
              stroke-dasharray="<%= (gaugeFrac * 283).toFixed(1) %> 283"/>
        <text x="100" y="92" text-anchor="middle" class="fill-current" style="font-family:'Oswald',sans-serif;font-size:34px;font-weight:600;fill:var(--text-primary)"><%= resilience.score %></text>
      </svg>
      <div class="text-center font-display text-[13px] tracking-[2px] uppercase mt-1" style="color:<%= gaugeColor %>;"><%= resilience.tier.label %></div>
      <div class="text-center text-[11px] text-[var(--text-muted)] mt-1">Resilience Score · 0-100</div>
    </div>
    <div class="grid grid-cols-3 gap-2 text-center mt-5 text-[11px] uppercase tracking-[1.4px] font-display text-[var(--text-muted)]">
      <div>
        <div class="text-[var(--success-green)] text-base font-semibold"><%= resilience.reportRate %>%</div>Report rate
      </div>
      <div>
        <div class="text-[var(--text-primary)] text-base font-semibold"><%= resilience.completionRate %>%</div>Training
      </div>
      <div>
        <div class="text-[var(--danger-red)] text-base font-semibold"><%= resilience.clickRate %>%</div>Click rate
      </div>
    </div>
  </div>

  <div class="card p-6 lg:col-span-2">
    <div class="flex items-center justify-between mb-4">
      <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)]">Top Phish Hunters · This Month</div>
      <a href="/leaderboard" class="font-display text-[11px] tracking-[1.8px] uppercase text-[var(--brand-red)] hover:opacity-80">Full Leaderboard →</a>
    </div>
    <ol class="space-y-2">
      <% if (!top5.length) { %>
        <li class="text-[var(--text-muted)] text-sm italic">No activity yet this month. Be the first.</li>
      <% } %>
      <% top5.forEach((row, i) => { %>
        <li class="flex items-center gap-3 px-3 py-2 rounded-lg <%= row.id === user.id ? 'bg-[var(--brand-red)]/10 border border-[var(--brand-red)]/30' : 'bg-[var(--black-soft)]' %>">
          <div class="font-display text-lg w-8 text-center <%= i === 0 ? 'text-[var(--accent-yellow)]' : 'text-[var(--text-muted)]' %>"><%= i + 1 %></div>
          <div class="flex-1 min-w-0">
            <div class="font-medium truncate"><%= row.first_name %> <%= row.last_name %><% if (row.id === user.id) { %> <span class="text-[var(--brand-red)] text-xs">(you)</span><% } %></div>
            <div class="text-[11px] text-[var(--text-muted)] uppercase tracking-[1.4px]"><%= row.department %></div>
          </div>
          <div class="font-display text-lg"><%= row.pts %></div>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- Learning moments -->
<% if (learningMoments && learningMoments.length) { %>
<section class="card p-6 mb-6 border-[var(--accent-yellow)]/30">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--accent-yellow)] mb-3">📚 Recent Learning Moments</div>
  <div class="space-y-4">
    <% learningMoments.forEach(m => { %>
      <div class="bg-[var(--black-soft)] rounded-lg p-4 border border-[var(--border-subtle)]">
        <div class="text-sm font-medium text-[var(--text-primary)]"><%= m.template_name %></div>
        <p class="text-[13px] text-[var(--text-secondary)] mt-2"><%= m.learning_points %></p>
        <% if (m.handbook_policy_refs && m.handbook_policy_refs.length) { %>
          <div class="mt-2 text-[11px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]">
            Handbook refs:
            <% m.handbook_policy_refs.forEach(r => { %>
              <a href="<%= HANDBOOK_URL %>" target="_blank" rel="noopener" class="text-[var(--brand-red)] mr-2">§<%= r %></a>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- Activity + Active training -->
<section class="grid lg:grid-cols-2 gap-6">
  <div class="card p-6">
    <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Recent Activity</div>
    <% if (!activity.length) { %>
      <div class="text-sm text-[var(--text-muted)] italic">No activity yet. Reporting a phishing email or finishing a training module will show up here.</div>
    <% } %>
    <ul class="divide-y divide-[var(--border-subtle)]">
      <% activity.forEach(a => { %>
        <li class="py-2 flex items-center justify-between text-sm">
          <div>
            <div class="text-[var(--text-primary)]"><%= a.reason %></div>
            <div class="text-[11px] text-[var(--text-muted)]"><%= new Date(a.created_at).toLocaleString() %></div>
          </div>
          <div class="font-display text-base text-[var(--brand-red)]">+<%= a.points %></div>
        </li>
      <% }) %>
    </ul>
  </div>

  <div class="card p-6">
    <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Active Training</div>
    <% if (!activeTraining.length) { %>
      <div class="text-sm text-[var(--text-muted)] italic">You've completed every training module. Outstanding work.</div>
    <% } %>
    <div class="space-y-3">
      <% activeTraining.forEach(t => { %>
        <a href="/training/<%= t.id %>" class="block bg-[var(--black-soft)] hover:bg-[var(--black-card-hover)] border border-[var(--border-subtle)] hover:border-[var(--brand-red)]/40 rounded-lg p-4 transition">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="text-[var(--text-primary)] font-medium"><%= t.title %></div>
              <div class="text-[11px] text-[var(--text-muted)] uppercase tracking-[1.4px] mt-1">
                <%= t.cmmc_control %> · <%= t.estimated_minutes %> min
              </div>
            </div>
            <div class="badge-yellow whitespace-nowrap">+<%= t.points_reward %> PTS</div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<% if (recentBadges && recentBadges.length) { %>
<section class="card p-6 mt-6">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Recent Badges</div>
  <div class="flex flex-wrap gap-3">
    <% recentBadges.forEach(b => { %>
      <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--black-soft)] border border-[var(--border-subtle)]">
        <span class="text-2xl"><%= b.icon %></span>
        <div class="leading-tight">
          <div class="text-sm font-medium"><%= b.name %></div>
          <div class="text-[10px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]"><%= b.tier %></div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('partials/foot') %>
