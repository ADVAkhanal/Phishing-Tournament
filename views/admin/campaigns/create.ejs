<%- include('../../partials/head') %>

<div class="mb-6">
  <a href="/admin/campaigns" class="font-display text-[11px] tracking-[1.6px] uppercase text-[var(--text-muted)] hover:text-[var(--brand-red)]">← Campaigns</a>
  <h1 class="font-display text-3xl tracking-[1.2px] uppercase mt-2">New Campaign</h1>
  <p class="text-[var(--text-secondary)] mt-2 max-w-2xl">Define the campaign metadata and pick which employees to target. The admin sends the actual phishing email out-of-band; PhishGuard tracks outcomes against this campaign record.</p>
</div>

<form method="POST" action="/admin/campaigns/new" class="card p-6 space-y-5 max-w-4xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="label">Campaign name</label>
      <input class="input" name="name" required maxlength="255" placeholder="e.g. Q2 2026 — ProShop Password Expiry">
    </div>
    <div>
      <label class="label">Difficulty</label>
      <select name="difficulty" class="input" required>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
        <option value="expert">Expert</option>
      </select>
    </div>
  </div>

  <div>
    <label class="label">Template</label>
    <select name="template_id" class="input" required>
      <option value="">-- choose template --</option>
      <% templates.forEach(t => { %>
        <option value="<%= t.id %>"><%= t.name %> (<%= t.difficulty %>)</option>
      <% }) %>
    </select>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="label">Start date</label>
      <input class="input" name="start_date" type="datetime-local">
    </div>
    <div>
      <label class="label">End date</label>
      <input class="input" name="end_date" type="datetime-local">
    </div>
  </div>

  <div>
    <label class="label">Description</label>
    <textarea class="input" name="description" rows="2" maxlength="1000"></textarea>
  </div>

  <fieldset class="border border-[var(--border-subtle)] rounded-lg p-4">
    <legend class="px-2 font-display text-[11px] tracking-[2px] uppercase text-[var(--text-muted)]">Target Employees</legend>
    <% const grouped = {}; users.forEach(u => { (grouped[u.department] = grouped[u.department] || []).push(u); }); %>
    <% Object.keys(grouped).sort().forEach(dept => { %>
      <div class="mt-3">
        <div class="font-display text-[11px] tracking-[1.8px] uppercase text-[var(--brand-red)] mb-2 flex items-center gap-2">
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" class="accent-[var(--brand-red)] dept-toggle" data-dept="<%= dept %>"> <%= dept %>
          </label>
        </div>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-1">
          <% grouped[dept].forEach(u => { %>
            <label class="inline-flex items-center gap-2 px-2 py-1 rounded hover:bg-[var(--black-soft)]">
              <input type="checkbox" name="user_ids" value="<%= u.id %>" class="accent-[var(--brand-red)] user-cb" data-dept="<%= u.department %>">
              <span class="text-[13px]"><%= u.first_name %> <%= u.last_name %></span>
            </label>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </fieldset>

  <div class="flex gap-3">
    <button type="submit" class="btn-primary">Create Campaign</button>
    <a href="/admin/campaigns" class="btn-secondary">Cancel</a>
  </div>
</form>

<script>
  document.querySelectorAll('.dept-toggle').forEach(t => {
    t.addEventListener('change', e => {
      const dept = t.dataset.dept;
      document.querySelectorAll(`.user-cb[data-dept="${dept}"]`).forEach(cb => { cb.checked = t.checked; });
    });
  });
</script>

<%- include('../../partials/foot') %>
