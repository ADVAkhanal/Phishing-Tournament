<%- include('../../partials/head') %>

<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-3 mb-6">
  <div>
    <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)]">Admin</div>
    <h1 class="font-display text-3xl tracking-[1.2px] uppercase">Template Library</h1>
    <p class="text-[var(--text-secondary)] mt-2 max-w-2xl">Twelve manufacturing-specific phishing simulations are pre-seeded. Each template carries red flags, learning points, and Advanced Companies Employee Handbook policy references.</p>
  </div>
  <a href="/admin/templates/new" class="btn-primary">+ New Template</a>
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% templates.forEach(t => { %>
    <a href="/admin/templates/<%= t.id %>" class="card p-5 hover:border-[var(--brand-red)]/40">
      <div class="flex items-start justify-between gap-2">
        <span class="badge"><%= t.category %></span>
        <span class="badge <%= t.difficulty === 'beginner' ? '' : t.difficulty === 'intermediate' ? 'badge-yellow' : t.difficulty === 'advanced' ? 'badge-orange' : 'badge-red' %>"><%= t.difficulty %></span>
      </div>
      <h2 class="font-display text-base tracking-[0.8px] uppercase mt-3"><%= t.name %></h2>
      <div class="text-[13px] text-[var(--text-secondary)] mt-2 italic">"<%= t.subject_line %>"</div>
      <% if (t.handbook_policy_refs && t.handbook_policy_refs.length) { %>
        <div class="mt-3 text-[10px] font-display tracking-[1.6px] uppercase text-[var(--text-muted)]">
          Handbook:
          <% t.handbook_policy_refs.forEach(r => { %><span class="text-[var(--brand-red)] mr-1">§<%= r %></span><% }) %>
        </div>
      <% } %>
      <% if (!t.is_active) { %><div class="mt-2 text-[10px] uppercase text-[var(--text-muted)]">INACTIVE</div><% } %>
    </a>
  <% }) %>
</div>

<%- include('../../partials/foot') %>
