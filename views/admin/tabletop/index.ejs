<%- include('../../partials/head') %>

<div class="mb-6">
  <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--brand-red)]">Admin</div>
  <h1 class="font-display text-3xl tracking-[1.2px] uppercase">Tabletop Exercises</h1>
  <p class="text-[var(--text-secondary)] mt-2 max-w-3xl">
    NCSC Exercise-in-a-Box style leadership drills — group discussion, not a quiz. Each scenario unfolds in stages
    with questions that have no single right answer. Run one with a senior leader, IT/security, a communications
    advisor, and a scribe in the room. This is exercise evidence for AT.L2-3.2.1, not a document nobody has used.
  </p>
  <p class="mt-3 inline-block text-[11px] font-display tracking-[1.6px] uppercase px-3 py-1 rounded bg-[var(--black-soft)] border border-[var(--border-subtle)] text-[var(--text-muted)]">
    EXERCISE — EXERCISE — EXERCISE: everything below is a rehearsal. Label it as such out loud before you start, so nobody in the room mistakes it for a real incident.
  </p>
</div>

<div class="grid md:grid-cols-3 gap-4 mb-8">
  <% exercises.forEach(ex => { %>
    <a href="/admin/tabletop/<%= ex.id %>" class="card p-5 hover:border-[var(--brand-red)] transition-colors block">
      <div class="font-display text-[10px] tracking-[1.8px] uppercase text-[var(--text-muted)] mb-1"><%= ex.cmmc_control || '' %></div>
      <div class="text-[15px] font-medium text-[var(--text-primary)]"><%= ex.title %></div>
      <p class="text-[13px] text-[var(--text-secondary)] mt-2 line-clamp-3"><%= ex.objective %></p>
      <div class="mt-3 flex items-center justify-between text-[11px] text-[var(--text-muted)]">
        <span><%= ex.estimated_minutes %> min</span>
        <span><%= ex.times_run %> run<%= ex.times_run === 1 ? '' : 's' %><%= ex.last_run ? ' · last ' + new Date(ex.last_run).toLocaleDateString() : '' %></span>
      </div>
    </a>
  <% }) %>
</div>

<div class="card overflow-hidden">
  <div class="px-5 py-3 border-b border-[var(--border-subtle)] font-display text-[12px] tracking-[1.8px] uppercase text-[var(--text-muted)]">Recent Sessions</div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-[10px] font-display tracking-[1.8px] uppercase text-[var(--text-muted)] bg-[var(--black-soft)] border-b border-[var(--border-subtle)]">
          <th class="text-left px-4 py-3">Exercise</th>
          <th class="text-left px-4 py-3">Date</th>
          <th class="text-left px-4 py-3">Facilitator</th>
          <th class="text-left px-4 py-3">Participants</th>
        </tr>
      </thead>
      <tbody>
        <% if (!sessions.length) { %>
          <tr><td colspan="4" class="text-center py-8 text-[var(--text-muted)] italic">No sessions logged yet. Pick a scenario above and run one.</td></tr>
        <% } %>
        <% sessions.forEach(s => { %>
          <tr class="border-b border-[var(--border-subtle)] last:border-0 hover:bg-[var(--black-card-hover)]">
            <td class="px-4 py-3 text-[var(--text-primary)]"><%= s.exercise_title %></td>
            <td class="px-4 py-3 text-[var(--text-muted)]"><%= new Date(s.session_date).toLocaleDateString() %></td>
            <td class="px-4 py-3 text-[var(--text-secondary)]"><%= s.first_name ? (s.first_name + ' ' + s.last_name) : '—' %></td>
            <td class="px-4 py-3 text-[var(--text-secondary)]"><%= (s.participants || []).join(', ') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/foot') %>
