<%- include('../../partials/head') %>

<a href="/admin/users" class="font-display text-[11px] tracking-[1.6px] uppercase text-[var(--text-muted)] hover:text-[var(--brand-red)]">← Users</a>

<div class="mt-2 mb-6">
  <h1 class="font-display text-3xl tracking-[1.2px] uppercase"><%= u.first_name %> <%= u.last_name %></h1>
  <div class="text-[var(--text-secondary)] mt-1"><%= u.email %> · <%= u.department %> · <%= u.role %></div>
</div>

<section class="grid lg:grid-cols-3 gap-6">
  <div class="card p-6 lg:col-span-1 space-y-5">
    <form method="POST" action="/admin/users/<%= u.id %>/update" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label class="label">First name</label><input class="input" name="first_name" required value="<%= u.first_name %>"></div>
      <div><label class="label">Last name</label><input class="input" name="last_name" required value="<%= u.last_name %>"></div>
      <div>
        <label class="label">Department</label>
        <select class="input" name="department" required>
          <% departments.forEach(d => { %><option value="<%= d %>" <%= u.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="label">Role</label>
        <select class="input" name="role">
          <option value="employee" <%= u.role === 'employee' ? 'selected' : '' %>>Employee</option>
          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
      </div>
      <button class="btn-primary w-full">Save</button>
    </form>

    <hr class="border-[var(--border-subtle)]">
    <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="label">Reset password</label>
      <input class="input" type="text" name="password" placeholder="new strong password">
      <button class="btn-secondary w-full">Reset Password</button>
    </form>

    <hr class="border-[var(--border-subtle)]">
    <% if (u.is_active) { %>
      <form method="POST" action="/admin/users/<%= u.id %>/deactivate" onsubmit="return confirm('Deactivate this user? Their audit history is retained.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-secondary w-full text-[var(--danger-red)] border-[var(--danger-red)]/40">Deactivate</button>
      </form>
    <% } else { %>
      <form method="POST" action="/admin/users/<%= u.id %>/activate">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-secondary w-full">Reactivate</button>
      </form>
    <% } %>
  </div>

  <div class="lg:col-span-2 space-y-6">
    <% if (badges && badges.length) { %>
      <div class="card p-5">
        <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Badges</div>
        <div class="flex flex-wrap gap-2">
          <% badges.forEach(b => { %>
            <div class="flex items-center gap-2 px-3 py-2 rounded bg-[var(--black-soft)] border border-[var(--border-subtle)]">
              <span class="text-xl"><%= b.icon %></span>
              <div class="leading-tight">
                <div class="text-sm"><%= b.name %></div>
                <div class="text-[10px] uppercase font-display tracking-[1.6px] text-[var(--text-muted)]"><%= b.tier %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="card p-5">
      <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Recent Points</div>
      <ul class="divide-y divide-[var(--border-subtle)] text-sm">
        <% if (!points.length) { %><li class="text-[var(--text-muted)] italic py-2">No points yet.</li><% } %>
        <% points.forEach(p => { %>
          <li class="py-2 flex justify-between">
            <div>
              <div><%= p.reason %></div>
              <div class="text-[11px] text-[var(--text-muted)]"><%= new Date(p.created_at).toLocaleString() %></div>
            </div>
            <div class="font-display text-base text-[var(--brand-red)]"><%= p.points > 0 ? '+' : '' %><%= p.points %></div>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="card p-5">
      <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Training History</div>
      <table class="w-full text-sm">
        <% if (!trainings.length) { %><tr><td class="py-2 text-[var(--text-muted)] italic">No training completions.</td></tr><% } %>
        <% trainings.forEach(t => { %>
          <tr class="border-b border-[var(--border-subtle)] last:border-0">
            <td class="py-2"><%= t.title %></td>
            <td class="py-2 text-right text-[var(--text-secondary)]"><%= t.quiz_score === null ? '—' : t.quiz_score + '%' %></td>
            <td class="py-2 text-right"><span class="badge <%= t.passed ? 'badge-green' : 'badge-orange' %>"><%= t.passed ? 'PASSED' : 'IN PROGRESS' %></span></td>
            <td class="py-2 text-[11px] text-[var(--text-muted)] text-right"><%= t.completed_at ? new Date(t.completed_at).toLocaleDateString() : '—' %></td>
          </tr>
        <% }) %>
      </table>
    </div>

    <div class="card p-5">
      <div class="font-display text-[12px] tracking-[2.2px] uppercase text-[var(--text-muted)] mb-3">Simulation History</div>
      <table class="w-full text-sm">
        <% if (!sims.length) { %><tr><td class="py-2 text-[var(--text-muted)] italic">No simulations yet.</td></tr><% } %>
        <% sims.forEach(s => { %>
          <tr class="border-b border-[var(--border-subtle)] last:border-0">
            <td class="py-2"><%= s.name %></td>
            <td class="py-2 text-[var(--text-secondary)]"><%= s.template || '—' %></td>
            <td class="py-2 text-right"><span class="badge"><%= s.outcome %></span></td>
            <td class="py-2 text-right text-[var(--text-muted)] text-[11px]"><%= s.time_to_report_seconds || '—' %>s</td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
</section>

<%- include('../../partials/foot') %>
