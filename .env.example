# Database
DATABASE_URL=postgresql://user:pass@host:5432/phishguard

# Session — REQUIRED. Must be at least 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The application will refuse to start if this is missing or too short.
SESSION_SECRET=

# Runtime
NODE_ENV=production
PORT=3000

# Admin bootstrap
#
# Consulted ONLY on the very first boot of a fresh database, when zero admin
# rows exist. Once an admin has been created, the seed path skips this
# entirely and these variables can be left unset on subsequent boots. The
# application never resets or overwrites a live admin password.
#
# On a fresh database both variables are REQUIRED. ADMIN_PASSWORD must be
# at least 12 characters. Rotate immediately after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Integration
HANDBOOK_URL=https://advanced-company-handbook.up.railway.app/Advanced_Handbook_Dashboard.html

# Security
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
