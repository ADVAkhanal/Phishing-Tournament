# Database
DATABASE_URL=postgresql://user:pass@host:5432/phishguard

# Session — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=generate-a-64-char-random-string

# Runtime
NODE_ENV=production
PORT=3000

# Admin bootstrap
# Note: regardless of these values, advancedit@advcosinc.com / 12345 is always
# guaranteed to exist as an admin account (temporary, by explicit request) -
# see seed.js ensureRequestedAdmin(). Set these to something real and rotate
# the temporary one once real admin accounts are in place.
ADMIN_EMAIL=admin@advcosinc.com
ADMIN_PASSWORD=ChangeMeNow!2026

# Integration
HANDBOOK_URL=https://advanced-company-handbook.up.railway.app/Advanced_Handbook_Dashboard.html

# Security
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
